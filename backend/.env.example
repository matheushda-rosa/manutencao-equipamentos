# ============================================================
# Variaveis de ambiente do backend
# Copie este arquivo para .env e preencha com os seus valores.
# O arquivo .env NUNCA vai para o Git (ver .gitignore).
# ============================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development

# Origens liberadas no CORS, separadas por virgula.
# Em producao, troque pelo dominio do Firebase Hosting.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Banco de dados (Supabase PostgreSQL) ---
# ATENCAO: sao duas URLs diferentes e isso importa.
# DATABASE_URL -> porta 6543 (pooler/pgbouncer), usada pela aplicacao em runtime
# DIRECT_URL   -> porta 5432 (conexao direta), usada pelo "prisma migrate"
# Pegue as duas em: Supabase > Project Settings > Database > Connection string
DATABASE_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.SEU_PROJECT_REF:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# --- Supabase Storage (upload das fotos) ---
SUPABASE_URL="https://SEU_PROJECT_REF.supabase.co"
# Chave de servico: NUNCA colocar no frontend. Supabase > Project Settings > API
SUPABASE_SERVICE_ROLE_KEY="sua-service-role-key"
SUPABASE_BUCKET="equipamentos"

# --- Firebase Authentication (verificacao do token no backend) ---
# Firebase Console > Configuracoes do projeto > Contas de servico > Gerar nova chave privada
FIREBASE_PROJECT_ID="seu-projeto"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com"
# A chave privada tem quebras de linha. Cole entre aspas e mantenha os \n literais.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nSUA_CHAVE\n-----END PRIVATE KEY-----\n"
